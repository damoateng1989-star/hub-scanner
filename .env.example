# Copy this file to .env (for running on your computer) or paste these into your host's
# "Variables" / "Environment" settings.

# --- Market data: alpaca (recommended), yfinance (free, less reliable) or demo (fake prices, for trying the app)
DATA_PROVIDER=alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# sip = full-market data (free plan has a 15-min delay; scans are timed for it). iex = real-time but IEX-only prices.
ALPACA_FEED=sip

# --- Telegram (from @BotFather). Each user connects their own chat from the Account page.
TELEGRAM_BOT_TOKEN=

# --- Accounts. The first account created is the admin. Optional: make another email admin.
ADMIN_EMAIL=
FREE_TICKER_LIMIT=3
# Your site's public address (needed for Google sign-in and reset links), e.g. https://hub-scanner.onrender.com
APP_URL=
# Google sign-in (console.cloud.google.com → Credentials → OAuth client ID). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password-reset emails via resend.com. Without it, reset links are written to the server log.
RESEND_API_KEY=
EMAIL_FROM=Hub Scanner <onboarding@resend.dev>

# --- Where the database lives. On Railway, mount a volume at /data and set DATA_DIR=/data
DATA_DIR=data

# --- Strategy settings
MIN_SESSIONS=4
HUB_K=1.5
HORIZON=10
TARGET_ATR=1.0
SHELF_MIN_ATR=0.5

# --- Scan times (ET, weekdays). Just after the 13:30 and 16:00 4H closes + the 15-min data delay.
SCAN_TIMES=13:47,16:17
# Pre-close warnings (~15 min before each 4H close, live IEX price). Empty = off.
PRECLOSE_TIMES=13:15,15:45

# --- Automatic paper trading (Alpaca PAPER account only; this app never places real-money orders)
PAPER_TRADING=off
PAPER_TRADE_USD=5000
PAPER_ALLOW_SHORT=on
ENTRY_TIMES=13:28,15:58

# --- Phone-call alerts (Twilio). Leave empty to turn off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# CALL_TO is only used to pre-fill the admin's number; each Pro user adds theirs under Account.
CALL_TO=
CALL_ON=preclose,breakout
